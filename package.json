{
  "name": "n8n-nodes-zsm",
  "version": "0.1.1",
  "description": "n8n nodes for a sales chat workspace: list sale accounts, find contacts by phone, check friendship and send messages.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "sales",
    "chat",
    "zsm"
  ],
  "license": "MIT",
  "author": {
    "name": "zsm-sdk contributors"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nguyentrunghieu98/n8n-nodes-zsm.git"
  },
  "main": "index.js",
  "files": [
    "index.js",
    "nodes",
    "credentials",
    "lib",
    "icons",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"console.log('No build step: package ships plain JavaScript files.')\"",
    "test": "node --test test/*.test.js"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "credentials/ZsmApi.credentials.js"
    ],
    "nodes": [
      "nodes/Zsm.node.js"
    ]
  },
  "dependencies": {
    "zsm-sdk": "^0.1.1"
  },
  "peerDependencies": {
    "n8n-workflow": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "n8n-workflow": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
